NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:11111/movie_db
FRONTEND_ORIGIN=http://localhost:5173
# Generate a unique secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=ubtv-api
JWT_AUDIENCE=ubtv-web
BCRYPT_COST=12
# Generate a second, distinct random secret for OTP HMACs (same command as JWT_SECRET).
EMAIL_OTP_SECRET=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# Swagger defaults to enabled outside production. Open /docs on this exact origin.
SWAGGER_ENABLED=true
SWAGGER_ORIGIN=http://localhost:3000
